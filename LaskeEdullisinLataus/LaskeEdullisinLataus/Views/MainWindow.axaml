<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaskeEdullisinLataus.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LaskeEdullisinLataus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
    Title="Laske Edullisin Lataus"
    Width="1040"
    Height="780"
    MinWidth="940"
    MinHeight="700">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <TextBlock Grid.Row="0"
                   Text="Cheapest EV Charging Time (Porssisahko v2)"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="18">
            <Border Padding="14" CornerRadius="8" Background="#F4F4F4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Inputs" FontSize="17" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="Auto,70,Auto,70" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Current SOC (%)" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CurrentSocText}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Column="2" Text="Target SOC (%)" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding TargetSocText}" HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,74,Auto,74" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Charging Time" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ChargeStartTimeText}" PlaceholderText="21:00" />
                        <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding ChargeEndTimeText}" PlaceholderText="07:00" />
                    </Grid>

                    <TextBlock Text="Estimated Battery Capacity (kWh)" />
                    <TextBox Text="{Binding BatteryCapacityKwhText}" />

                        <TextBlock Text="Total Power (kW)" />
                        <TextBox Text="{Binding TotalPowerKwText}" />

                        <TextBlock Text="Base Loss (W)" />
                        <TextBox Text="{Binding BaseLossWattsText}" />

                        <TextBlock Text="Current Dependant Factor" />
                        <TextBox Text="{Binding CurrentDependentFactorText}" />

                        <TextBlock Text="Computed Charge Power" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EffectiveChargePowerText}" />

                        <TextBlock Text="Computed Total Loss" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalLossWattsText}" />

                    <TextBlock Text="Default 3 x 8 A x 230 V = 5.52 kW" FontStyle="Italic" />

                    <Button Content="Fetch Prices And Calculate"
                            Command="{Binding CalculateCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,6,0,0" />

                        <Button Content="Save Current Values As Default"
                            Command="{Binding SaveDefaultsCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,2,0,0" />

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                <Border Grid.Row="0" Padding="14" CornerRadius="8" Background="#EEF4FF">
                    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontSize="14" />
                </Border>

                <Border Grid.Row="1" Padding="10" CornerRadius="8" Background="#FAFAFA">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="Selected Charging Segments" FontSize="17" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding CheapestWindowSegments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChargeSegmentViewModel">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#DDDDDD" Padding="0,7">
                                            <Grid ColumnDefinitions="170,170,120,120,*">
                                                <TextBlock Grid.Column="0" Text="{Binding Start, StringFormat='{}{0:dd.MM HH:mm}'}" />
                                                <TextBlock Grid.Column="1" Text="{Binding End, StringFormat='{}{0:dd.MM HH:mm}'}" />
                                                <TextBlock Grid.Column="2" Text="{Binding PriceCentsPerKWh, StringFormat='{}{0:F3} c/kWh'}" />
                                                <TextBlock Grid.Column="3" Text="{Binding GridEnergyKWh, StringFormat='{}{0:F2} kWh'}" />
                                                <TextBlock Grid.Column="4" Text="{Binding CostEur, StringFormat='{}{0:F3} EUR'}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
